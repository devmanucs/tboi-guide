{
  "name": "basement-oracle",
  "version": "0.1.0",
  "private": true,
  "description": "Offline companion for The Binding of Isaac: Afterbirth+",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-rebuild -f -w better-sqlite3 && electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-rebuild -f -w better-sqlite3 && electron-vite build",
    "build:data": "tsx scripts/build-dataset.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/desktop/electron/tsconfig.json",
    "preview": "electron-rebuild -f -w better-sqlite3 && electron-vite preview"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "better-sqlite3": "^12.4.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.8.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^38.2.2",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
